@using System.Text.Json
@model Etkinlik

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Etkinlik Detayları</title>
    <style>
        :root {
            --primary-color: #1E3A8A;
            --secondary-color: #3B82F6;
            --background-color: #F0F4F8;
            --white: #FFFFFF;
            --text-color: #2D3748;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .event-detail-container {
            background-color: var(--white);
            border-radius: 10px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 600px;
            padding: 30px;
        }

        .event-detail-header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 10px;
        }

        .event-detail-title {
            color: var(--primary-color);
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        .event-detail-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .event-detail-info-item {
            display: flex;
            flex-direction: column;
        }

        .event-detail-info-label {
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .event-detail-info-value {
            background-color: var(--background-color);
            padding: 8px;
            border-radius: 4px;
            font-size: 0.9rem;
        }

        .event-detail-description {
            background-color: var(--background-color);
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
        }

        .event-detail-actions {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .btn {
            flex-grow: 1;
            padding: 10px;
            border: none;
            border-radius: 4px;
            color: var(--white);
            cursor: pointer;
            transition: background-color 0.3s;
            font-size: 0.9rem;
        }

        .btn-update {
            background-color: var(--primary-color);
        }

            .btn-update:hover {
                background-color: var(--secondary-color);
            }

        .btn-delete {
            background-color: #E53E3E;
        }

            .btn-delete:hover {
                background-color: #C53030;
            }

        .btn-back {
            background-color: #718096;
        }

            .btn-back:hover {
                background-color: #4A5568;
            }

        @@media (max-width: 600px) {
            .event-detail-info {
                grid-template-columns: 1fr;
            }

            .event-detail-container {
                padding: 15px;
            }
        }

        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            padding: 15px;
            margin-top: 20px;
            border-radius: 4px;
        }

        .alternative-events {
            margin-top: 10px;
        }

            .alternative-events h4 {
                color: #856404;
                margin-bottom: 10px;
            }

            .alternative-events ul {
                list-style-type: none;
                padding: 0;
            }

            .alternative-events li {
                background-color: #f8f9fa;
                margin-bottom: 5px;
                padding: 10px;
                border-radius: 4px;
            }
    </style>
</head>
<body>
    <div class="event-detail-container">
        <div class="event-detail-header">
            <h1 class="event-detail-title">@Model.EtkinlikAdi</h1>
        </div>

        <div class="event-detail-description">
            <div class="event-detail-info-label">Açıklama</div>
            <div>@Model.Aciklama</div>
        </div>

        <div class="event-detail-info">
            <div class="event-detail-info-item">
                <div class="event-detail-info-label">Etkinlik ID</div>
                <div class="event-detail-info-value">@Model.EtkinlikID</div>
            </div>
            <div class="event-detail-info-item">
                <div class="event-detail-info-label">Kategori</div>
                <div class="event-detail-info-value">@Model.Kategori</div>
            </div>
            <div class="event-detail-info-item">
                <div class="event-detail-info-label">Tarih</div>
                <div class="event-detail-info-value">@Model.Tarih.ToShortDateString()</div>
            </div>
            <div class="event-detail-info-item">
                <div class="event-detail-info-label">Saat</div>
                <div class="event-detail-info-value">@Model.Saat</div>
            </div>
            <div class="event-detail-info-item">
                <div class="event-detail-info-label">Süre (dk)</div>
                <div class="event-detail-info-value">@Model.EtkinlikSuresi</div>
            </div>
            <div class="event-detail-info-item">
                <div class="event-detail-info-label">Konum</div>
                <div class="event-detail-info-value">@Model.Konum</div>
            </div>
        </div>

        <div class="event-detail-actions">
            <form asp-controller="KullaniciPanel" asp-action="Guncelle" method="get">
                <input type="hidden" name="etkinlikID" value="@Model.EtkinlikID" />
                <button type="submit" class="btn btn-update">Güncelle</button>
            </form>
            <form asp-action="Sil" method="post">
                <input type="hidden" name="etkinlikID" value="@Model.EtkinlikID" />
                <button type="submit" class="btn btn-delete" onclick="return confirm('Bu etkinliği silmek istediğinizden emin misiniz?')">Sil</button>
            </form>
            <form asp-action="Katil" method="post">
                <input type="hidden" name="etkinlikID" value="@Model.EtkinlikID" />
                <button type="submit" class="btn btn-update">Etkinliğe Katıl</button>
            </form>

            <button onclick="window.location.href='@Url.Action("Main", "KullaniciPanel")'" class="btn btn-back">Geri Dön</button>
        </div>
        @if (TempData["KatılımMesajı"] != null)
        {
            <div class="alert alert-success" style="margin-top: 20px;">
                @TempData["KatılımMesajı"]
            </div>
        }
        @{
            // TempData'dan gelen JSON string'ini deserialize edin
            var alternatifEtkinliklerJson = TempData["AlternatifEtkinlikler"]?.ToString();
            var alternatifEtkinlikler = string.IsNullOrEmpty(alternatifEtkinliklerJson)
            ? new List<Etkinlik>()
            : JsonSerializer.Deserialize<List<Etkinlik>>(alternatifEtkinliklerJson);
        }

        @if (alternatifEtkinlikler != null && alternatifEtkinlikler.Any())
        {
            <div class="alert alert-warning">
                <p>Bu etkinlik başka bir etkinlikle çakışıyor!</p>
                <ul>
                    @foreach (var etkinlik in alternatifEtkinlikler)
                    {
                        <li>@etkinlik.EtkinlikAdi - @etkinlik.Tarih.ToShortDateString() @etkinlik.Saat</li>
                    }
                </ul>
            </div>
        }
    </div>
</body>
</html>