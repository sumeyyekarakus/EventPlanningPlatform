<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Paneli - Ana Sayfa</title>
    <style>
        /* Genel Stil */
        body {
            background-color: #1E3A8A; /* Koyu mavi arka plan */
            font-family: Arial, sans-serif;
            color: #ffffff;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 600px;
            background-color: #ffffff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            color: #333;
        }

        h1, h2, h3 {
            color: #1E3A8A;
            text-align: center;
        }

        ul {
            list-style-type: none;
            padding: 0;
        }

            ul li {
                margin-bottom: 10px;
                font-size: 16px;
            }

                ul li a {
                    color: #4F46E5;
                    text-decoration: none;
                    font-weight: bold;
                }

                    ul li a:hover {
                        text-decoration: underline;
                    }

        button {
            width: 100%;
            padding: 14px;
            background-color: #4F46E5; /* Mor buton rengi */
            color: #ffffff;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            button:hover {
                background-color: #4338CA; /* Buton hover (koyu mor) */
            }

        .logout-form {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Admin Paneli</h1>
        <h2>Hoş Geldiniz!</h2>

        <h3>Sistem İstatistikleri</h3>
        <ul>
            <li>Toplam Kullanıcı Sayısı: @ViewBag.Stats.TotalUsers</li>
            <li>Toplam Etkinlik Sayısı: @ViewBag.Stats.TotalEvents</li>
            <li>Onaylanmış Etkinlik Sayısı: @ViewBag.Stats.ApprovedEvents</li>
            <li>Toplam Katılımcı Sayısı: @ViewBag.Stats.TotalParticipants</li>
        </ul>

        <h3>Yönetim Seçenekleri</h3>
        <ul>
            <li><a href="/AdminPanel/KullaniciYonetim">Kullanıcı Yönetimi</a></li>
            <li><a href="/AdminPanel/EtkinlikYonetim">Etkinlik Yönetimi</a></li>
            <li><a href="/AdminPanel/Harita">Harita</a></li>
        </ul>

        <h3>Sistem Çıkışı</h3>
        <form class="logout-form" method="post" action="/Account/Logout">
            <button type="submit">Çıkış Yap</button>
        </form>
    </div>
</body>
</html>